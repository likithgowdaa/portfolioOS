# ─────────────────────────────────────────────────────────────────────────────
# PortfolioOS — environment template
#
# 1. Copy this file to `.env`:            cp .env.example .env
# 2. Fill in real values where noted.
#
# NEVER commit `.env`. It holds real secrets and is git-ignored.
# `docker compose` reads this file automatically for interpolation.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ─────────────────────────────────────────────────────────────────

# Public base URL of the site. Used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the backend API, called from the browser (client-side).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Studio Auth (passphrase) ─────────────────────────────────────────────────

# The passphrase that unlocks Studio. Compared server-side with a timing-safe
# comparison; never stored and never sent to the client. Studio is fail-closed:
# without a value, no one can sign in. Choose a long random value, e.g.:
#   openssl rand -hex 24
STUDIO_ADMIN_SECRET=

# Secret used to sign Studio session cookies. Generate with:
#   openssl rand -hex 32
STUDIO_SESSION_SECRET=

# ── Backend ──────────────────────────────────────────────────────────────────

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Runtime environment: development | production | test.
ENVIRONMENT=development

# Backend log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ── Database (Supabase) ──────────────────────────────────────────────────────

# Supabase project URL — Dashboard → Settings → API. Required in Sprint 02+.
SUPABASE_URL=

# Public anon key — Dashboard → Settings → API. Safe to expose client-side.
SUPABASE_ANON_KEY=

# Server-side key for the CMS store (Dashboard → Settings → API → service_role).
# A secret — never expose it to the browser. Required for Studio reads/writes.
# Also used for media uploads to Supabase Storage (bucket `media`, created on
# first upload; backfill legacy local uploads with `npm run seed:media`).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string (Supabase pooler) for the backend.
DATABASE_URL=
